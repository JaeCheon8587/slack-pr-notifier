# ============================================================
# Slack MR Notifier — 환경 변수 예시
#
# 각 키의 의미와 기본값 설명은 docs/setup.html §02 를 보세요.
# 기본값은 app/config.py 가 원본입니다.
# 여기 없는 키도 app/config.py 에 있으면 그대로 동작합니다.
# ============================================================

APP_NAME=Slack MR Notifier
APP_ENV=local

# 로깅 마스터 스위치 (app/logging_setup.py) — 모든 모듈이 "uvicorn.error" 로거 하나를
# 쓰므로 이 플래그 하나로 앱 로그와 uvicorn 액세스 로그가 함께 꺼진다. 레벨은 고정하지
# 않는다 — uvicorn --log-level 이 그대로 결정한다.
LOG_ENABLED=false

# ------------------------------------------------------------
# GitLab
# ------------------------------------------------------------
GITLAB_URL=https://gitlab.company.example
# 미설정이면 웹훅을 전부 거절한다 (fail-closed).
GITLAB_WEBHOOK_SECRET=replace-with-a-long-random-value
# api scope. 승인/머지, 그리고 리바이스를 켰다면 push 에도 이 계정이 쓰인다.
GITLAB_TOKEN=gitlab-project-or-personal-access-token
GITLAB_VERIFY_SSL=true

# ------------------------------------------------------------
# Slack
# ------------------------------------------------------------
# chat:write 와 files:write 가 모두 필요하다 (files:write 가 없으면 리포트 첨부 실패).
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_CHANNEL_ID=C0123456789

# Socket Mode (app/slack_socket.py) — 인바운드 /webhooks/slack/actions 대신 아웃바운드
# WebSocket 으로 버튼/모달을 받는 경로. 기본 off, App-Level Token(xapp-...) 필요.
SLACK_APP_TOKEN=
SLACK_SOCKET_MODE=false

# 버튼에 심는 서명 토큰용 키.
ACTION_TOKEN_SECRET=replace-with-another-long-random-value

# ------------------------------------------------------------
# 승인자 — 저장소별 매핑 (구 SLACK_ALLOWED_USER_IDS 를 대체)
#
# repo_slug -> Slack user id 목록. 값은 콤마 문자열 또는 리스트.
# 매핑에 없는 저장소는 승인자 0명 = fail-closed (아무도 승인할 수 없고,
# 해당 MR 은 알림 단계에서 manual 로 전환된다).
# ------------------------------------------------------------
REVIEWER_MAP={"group/project": "U111,U222", "group/other": ["U333"]}

# 봇 자신의 push 를 사람 push 와 구분하는 데 쓴다. 리바이스를 켠다면 설정 권장.
BOT_USERNAME=
BOT_EMAIL=
BOT_GIT_NAME=
BOT_GIT_EMAIL=

# ------------------------------------------------------------
# AI 요약 (알림 메시지용) — 로그인된 `claude` CLI 를 헤드리스로 호출한다.
# 실패하거나 시간 초과되면 요약 없이 알림만 전송한다.
# ------------------------------------------------------------
AI_ENABLED=true
AI_MODEL=claude-opus-4-8
AI_EFFORT=high
AI_MAX_INPUT_CHARS=240000
AI_TIMEOUT_SECONDS=180
# 현재 집행되지 않는다 (어떤 호출에도 전달되지 않음). docs/setup.html §08 참조.
AI_MAX_BUDGET_USD=1.0
# CLAUDE_BIN=C:\path\to\claude.cmd   # `claude` 가 PATH 에 없을 때만
# CODEX_BIN=C:\path\to\codex.cmd     # `codex` 가 PATH 에 없을 때만

# ------------------------------------------------------------
# 리바이스 (의견 -> 실제 수정 -> 커밋/푸시)
#
# stub   = 아무것도 하지 않음 (기본)
# claude = 단일 호출 러너
# staged = 8노드 DAG (codex exec). 실제 운용 대상.
# ------------------------------------------------------------
AI_RUNNER=stub
WORKSPACE_ROOT=workspaces

# 타이머 부등식을 반드시 지킬 것:
#   REVISE_QUEUE_WAIT_LIMIT < REVISE_WALL_CLOCK_SECONDS < REVISING_TIMEOUT
# 뒤집히면 스위퍼가 진행 중인 작업을 죽인다.
REVISE_QUEUE_WAIT_LIMIT=600
REVISE_STAGE_TIMEOUT_SECONDS=600
REVISE_WALL_CLOCK_SECONDS=2400

# 빈 값이면 codex CLI 기본 모델.
REVISE_STAGE_MODEL=
REVISE_STAGE_EFFORT=high
# 현재 집행되지 않는다.
REVISE_STAGE_BUDGET_USD=1.5

REVISE_MAX_CHANGED_FILES=10
REVISE_MAX_CHANGED_LINES=400
# 되물음(clarify) 횟수 상한. 라운드 상한 3 은 코드 상수라 설정으로 바꿀 수 없다.
REVISE_CLARIFY_LIMIT=2

# ------------------------------------------------------------
# mrdoc — 문서(md) 지배 MR 의 변경 리포트 레일
# 둘 다 true 여야 mrdoc 이 리포트를 인수한다.
# ------------------------------------------------------------
MRDOC_ENABLED=false
MRDOC_SATELLITE_ENABLED=false
MRDOC_DOC_RATIO_THRESHOLD=0.8
MRDOC_SATELLITE_MODEL=
MRDOC_SATELLITE_TIMEOUT_SECONDS=600
MRDOC_MAX_FILES=40
MRDOC_FANOUT=5
# 현재 집행되지 않는다.
MRDOC_SATELLITE_BUDGET_USD=1.0

# ------------------------------------------------------------
# 저장소 · 스위퍼 · 알림 아웃박스
# ------------------------------------------------------------
DB_PATH=mr_review.db
SWEEP_INTERVAL=60
MERGING_TIMEOUT=300
REVISING_TIMEOUT=3000
NOTIFY_RETRY_BASE=30
NOTIFY_MAX_ATTEMPTS=5

# ------------------------------------------------------------
# 폴링 (P.2 수집 보완 경로, app/gitlab_poller.py)
# 인바운드 웹훅이 막힌 환경의 대체 경로. PROJECT_IDS 가 비면 켜도 동작하지 않는다.
# ------------------------------------------------------------
POLL_ENABLED=false
POLL_INTERVAL=60
POLL_PROJECT_IDS=

# ------------------------------------------------------------
# 범용 HTML 리뷰 리포트 (mrdoc 이 인수하지 않는 MR)
# 알림 스레드에 파일로 첨부되고 REPORT_HTML_DIR 에 아카이브된다.
# ------------------------------------------------------------
REPORT_HTML_ENABLED=true
REPORT_HTML_DIR=reports
