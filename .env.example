APP_NAME=Slack MR Notifier
APP_ENV=local
GITLAB_URL=https://gitlab.company.example
GITLAB_WEBHOOK_SECRET=replace-with-a-long-random-value
GITLAB_TOKEN=gitlab-project-or-personal-access-token
GITLAB_VERIFY_SSL=true
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_CHANNEL_ID=C0123456789
SLACK_ALLOWED_USER_IDS=U0123456789
# Socket Mode (app/slack_socket.py) — outbound-only WebSocket alternative to the inbound /webhooks/slack/actions route for button/modal interactions when inbound HTTP from Slack is blocked; off by default, requires an App-Level Token (xapp-...).
SLACK_APP_TOKEN=
SLACK_SOCKET_MODE=false
ACTION_TOKEN_SECRET=replace-with-another-long-random-value

# AI review — analyzed by the Claude Code CLI (`claude`) invoked headlessly.
# Uses your existing Claude Code login; no API key required. All values are optional.
AI_ENABLED=true
AI_MODEL=claude-opus-4-8
AI_EFFORT=high
AI_MAX_INPUT_CHARS=240000
AI_TIMEOUT_SECONDS=180
AI_MAX_BUDGET_USD=1.0
# CLAUDE_BIN=C:\path\to\claude.cmd   # only if `claude` is not on PATH

# Polling mode (P.2 폴링 수집 경로, app/gitlab_poller.py) — 인바운드 웹훅이 방화벽 정책으로 막힌 환경의 주 수집 경로; 기본은 비활성, PROJECT_IDS는 콤마구분(예: 12,918).
POLL_ENABLED=false
POLL_INTERVAL=60
POLL_PROJECT_IDS=

# HTML review report — MR 요약은 슬랙 메시지로 전송되고, 전체 리포트(report-*.html)는 알림 스레드에 파일 첨부되며 REPORT_HTML_DIR에 아카이브됩니다.
# 업로드에는 Slack files:write 스코프가 필요합니다.
REPORT_HTML_ENABLED=true
REPORT_HTML_DIR=reports
